<main class="page page--auth">
  <section class="card">
    <header class="card__header">
      <h1 class="card__title">Войти</h1>
      <p class="card__subtitle">Добро пожаловать</p>
    </header>
    <form class="form form--auth">
      {{> input label="Логин" type="text" name="login" placeholder="Логин" }}
      {{> input label="Пароль" type="password" name="password" placeholder="Пароль" }}
      <button type="submit" class="btn">Войти</button>
    </form>
  </section>
</main>

